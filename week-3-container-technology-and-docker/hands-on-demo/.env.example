# Copy to .env:  cp .env.example .env
# Used by `uv run python main.py` (running WITHOUT Docker) and by Docker Compose.

# Running the app directly on your machine: the database is reachable on localhost
DATABASE_URL=postgresql://appuser:change-me@localhost:5432/appdb
PORT=8000

# Read by compose.yaml
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
