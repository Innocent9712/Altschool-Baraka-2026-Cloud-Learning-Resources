# ==============================================================================
# A FIRST, SIMPLE DOCKERFILE (single stage)
# ==============================================================================
# Good enough to run the app, and easy to read. Compare it with `Dockerfile`,
# which improves on it (smaller image, non-root user, health check).
# ==============================================================================

# Start from an official Python image. Pin the version: `python:latest` would
# silently change under you.
FROM python:3.13-slim

# Install uv (a fast Python package manager) by copying its binary from uv's own image
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv

# All following commands run inside /app (created if it doesn't exist)
WORKDIR /app

# Copy ONLY the dependency files first, then install. This layer is cached and
# reused on every rebuild until pyproject.toml or uv.lock changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Use the virtual environment uv created
ENV PATH="/app/.venv/bin:$PATH"

# Copy the application code LAST: it changes most often
COPY main.py ./

# Documents which port the app listens on (publishing it is done with `docker run -p`)
EXPOSE 8000

# The command the container runs. Exec form (a JSON list) so signals like
# SIGTERM from `docker stop` reach uvicorn directly.
# --host 0.0.0.0 is essential: 127.0.0.1 would only be reachable from INSIDE the container.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
